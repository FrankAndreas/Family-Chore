# Copy this file to .env (next to docker-compose.yml) and fill in the values.
# Never commit .env to version control. See README_DOCKER.md for details.

# --- Required: PostgreSQL credentials (used by both the db and backend services) ---
# Postgres only applies these when it creates a new database. For an existing
# database, use the credentials it was created with (see README_DOCKER.md).
POSTGRES_USER=chorespec_admin
POSTGRES_PASSWORD=<generate-a-strong-random-password>
POSTGRES_DB=chorespec

# --- Strongly recommended: keys that must survive updates ---
# If left empty they are auto-generated inside the container and replaced on
# every update, which logs everyone out and breaks push notifications.

# Generate all three keys with (prints lines ready to paste here):
#   docker run --rm ghcr.io/frankandreas/family-chore-backend:latest python -m backend.generate_keys
JWT_SECRET_KEY=

# Web Push (VAPID) key pair
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:your@email.com

# --- Optional ---

# Set to true only when the app is served over HTTPS. The login cookie is then
# HTTPS-only, so with true on plain http://<NAS_IP>:8080 nobody can log in.
COOKIE_SECURE=false

# Only needed if the frontend is served from a different origin than the
# bundled one (the bundled frontend proxies /api, so leave empty by default).
CORS_ORIGINS=

# SMTP for email notifications
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
