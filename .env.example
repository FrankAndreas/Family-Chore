# Copy this file to .env and fill in all values before running docker-compose.
# Never commit .env to version control.

# PostgreSQL credentials (used by both the db and backend services)
POSTGRES_USER=chorespec_admin
POSTGRES_PASSWORD=<generate-a-strong-random-password>
POSTGRES_DB=chorespec

# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<generate-a-64-char-hex-string>

# VAPID keys for Web Push — generated automatically on first boot if omitted
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:your@email.com

# SMTP for email notifications (optional)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Allowed CORS origins (comma-separated, required in production)
CORS_ORIGINS=https://your-domain.com

# Set to true only when the app is served over HTTPS
COOKIE_SECURE=true
